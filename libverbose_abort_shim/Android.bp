    name: "libverbose_abort_shim",
    srcs: ["verbose_abort_shim.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "liblog",
    ],
    compile_multilib: "64",
    vendor: true,
    recovery_available: true,
}
